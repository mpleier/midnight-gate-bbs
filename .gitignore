# local configuration (contains the sysop/admin password hash)
config.json

# runtime data — user accounts, messages, calls, per-door state
data/

# uploads live on the operator's disk, not in git
files/

# installed doors are per-machine (and often contain licensed binaries);
# only the drop folders are tracked
doors/*
!doors/install/
!doors/install/.gitkeep
!doors/archives/
!doors/archives/.gitkeep
doors/install/*
doors/archives/*
!doors/install/.gitkeep
!doors/archives/.gitkeep

node_modules/
npm-debug.log*
*.log
stderr.txt
stdout.txt

# build artifacts
public/audio/*.wav
test/.tmp-*/

.DS_Store
Thumbs.db
